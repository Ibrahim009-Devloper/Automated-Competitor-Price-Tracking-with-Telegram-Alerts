# ==============================================================================
# Price Monitoring Bot - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Database backend selection:
# - If DATABASE_URL is set, the bot connects to PostgreSQL (e.g. Supabase).
# - If unset or empty, the bot defaults to the local SQLite database file (DATABASE_PATH).
# IMPORTANT: For Supabase, use the "Session pooler" connection string (IPv4/IPv6 compatible, Port 5432 or 6543).
# Special characters in your password (e.g. @, #, %) must be URL percent-encoded (e.g. @ -> %40).
# Example: postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# SQLite fallback database path (used when DATABASE_URL is not set)
DATABASE_PATH=prices.db

# Path to the sites configuration file (default: config/sites.yaml)
CONFIG_PATH=config/sites.yaml

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Telegram Bot Credentials
# 1. Price Monitoring Alerts Bot (Price drops, increases, stock changes, summaries)
TELEGRAM_BOT_TOKEN=your_price_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# 2. Error and Warning Alerts Bot (Scraping errors, 403 blocks, CAPTCHA alerts)
TELEGRAM_ERROR_BOT_TOKEN=your_error_bot_token_here
TELEGRAM_ERROR_CHAT_ID=your_chat_id_here
